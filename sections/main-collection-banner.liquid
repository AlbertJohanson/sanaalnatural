{% comment %}theme-check-disable ImgLazyLoading{% endcomment %}
{{ 'san-collection-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign is_catalog = false
  if collection.handle == 'all' or template.suffix == 'all'
    assign is_catalog = true
  endif
-%}

{%- comment -%} ═══════ CATALOG MASTHEAD — shared by /collections/all and /collections/[handle] ═══════ {%- endcomment -%}
<section class="san-catalog{% if is_catalog %} san-catalog--all{% endif %}" aria-label="{{ collection.title | escape }}">
  <div class="san-catalog__grain" aria-hidden="true"></div>
  <div class="san-catalog__glow" aria-hidden="true"></div>
  <div class="san-catalog__watermark" aria-hidden="true"><span>Sana al Natural</span></div>

  <div class="san-catalog__ambient" aria-hidden="true">
    <span class="san-catalog__leaf san-catalog__leaf--1"><svg viewBox="0 0 60 60" fill="none"><path d="M30 6 C14 20 6 36 12 50 C16 58 30 60 38 52 C46 44 52 28 30 6Z" fill="currentColor"/></svg></span>
    <span class="san-catalog__leaf san-catalog__leaf--2"><svg viewBox="0 0 60 60" fill="none"><path d="M30 6 C14 20 6 36 12 50 C16 58 30 60 38 52 C46 44 52 28 30 6Z" fill="currentColor"/></svg></span>
  </div>

  <div class="san-catalog__inner">
    <nav class="san-catalog__breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">{{ 'blogs.collections.home' | t }}</a>
      <span aria-hidden="true">·</span>
      <a href="{{ routes.collections_url }}">{{ 'blogs.collections.title' | t }}</a>
      {%- unless is_catalog -%}
        <span aria-hidden="true">·</span>
        <span class="san-catalog__breadcrumb-current" aria-current="page">{{ collection.title | escape }}</span>
      {%- endunless -%}
    </nav>

    <p class="san-catalog__eyebrow">
      {%- if is_catalog -%}{{ 'blogs.collections.all_eyebrow' | t }}{%- else -%}{{ 'blogs.collections.title' | t }}{%- endif -%}
    </p>

    {%- if is_catalog -%}
      {%- assign cat_heading = 'blogs.collections.all_heading' | t -%}
      <h1 class="san-catalog__title">
        {%- assign cat_parts = cat_heading | split: '|' -%}
        {%- for part in cat_parts -%}
          {%- if forloop.index == 2 -%}<em>{{ part }}</em>{%- else -%}{{ part }}{%- endif -%}
        {%- endfor -%}
      </h1>
    {%- else -%}
      <h1 class="san-catalog__title san-catalog__title--collection">{{ collection.title | escape }}</h1>
    {%- endif -%}

    {%- if is_catalog -%}
      {%- liquid
        assign hero_subtitle = 'blogs.collections.all_subtitle' | t
        if section.settings.show_collection_description and collection.description != blank
          assign hero_subtitle = collection.description | strip_html
        endif
      -%}
      <p class="san-catalog__subtitle">{{ hero_subtitle }}</p>
    {%- endif -%}

    <p class="san-catalog__count">{{ 'products.facets.product_count_simple' | t: count: collection.products_count }}</p>

    {%- if is_catalog -%}
      {%- assign chip_collections = collections | sort: 'all_products_count' | reverse -%}
      {%- if chip_collections.size > 1 -%}
        <div class="san-catalog__browse">
          <span class="san-catalog__browse-label">{{ 'blogs.collections.all_browse' | t }}</span>
          <ul class="san-catalog__chips" role="list">
            {%- for chip in chip_collections limit: 10 -%}
              {%- unless chip.handle == 'all' -%}
                <li>
                  <a href="{{ chip.url }}" class="san-catalog__chip">
                    {{ chip.title | escape }}
                    <span class="san-catalog__chip-n">{{ chip.all_products_count }}</span>
                  </a>
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "hero_height",
      "label": "Altura del hero",
      "options": [
        { "value": "small",  "label": "Pequeño" },
        { "value": "medium", "label": "Mediano" },
        { "value": "large",  "label": "Grande" }
      ],
      "default": "medium"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    }
  ]
}
{% endschema %}
