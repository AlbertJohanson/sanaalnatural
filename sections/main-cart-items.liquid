{%- comment -%}
  Sana Al Natural — Custom cart page (v5, deep-green canvas).
  Replaces Dawn's main-cart-items + main-cart-footer pair: this single section
  renders the whole page — left column of white item cards, right sticky
  "order slip" summary card with checkout + dynamic payment buttons.

  JS contract (san-cart.js, self-contained — Dawn's cart.js is NOT used):
    - <san-cart-page data-section-id> owns all behavior.
    - [data-swap="head|items|totals"] regions are re-rendered via the Section
      Rendering API after every change; checkout + payment buttons live
      OUTSIDE the swap regions so their iframes survive updates.
    - [data-line] + [data-quantity] on each card; [data-action] on controls.
    - Remove links keep item.url_to_remove so they work without JS.
{%- endcomment -%}

{{ 'san-cart.css' | asset_url | stylesheet_tag }}
<script src="{{ 'san-cart.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<san-cart-page
  class="san-cart section-{{ section.id }}-padding{% if cart == empty %} is-empty{% endif %}"
  data-section-id="{{ section.id }}"
  data-error-text="{{ 'san.cart.error' | t | escape }}"
>
  <div class="san-cart__container">
    <header class="san-cart__head" data-swap="head" data-item-count="{{ cart.item_count }}">
      <p class="san-cart__eyebrow">{{ 'san.cart.eyebrow' | t }}</p>
      <div class="san-cart__head-row">
        <h1 class="san-cart__title">
          {{ 'san.cart.title' | t }}
          <span class="san-cart__count">({{ cart.item_count }})</span>
        </h1>
        <a href="{{ routes.all_products_collection_url }}" class="san-cart__continue">
          {{- 'general.continue_shopping' | t -}}
        </a>
      </div>
    </header>

    <p class="san-cart__errors" data-errors role="alert" aria-live="assertive"></p>

    <form action="{{ routes.cart_url }}" method="post" id="cart" class="san-cart__form">
      <div class="san-cart__main" data-swap="items">
        {%- if cart == empty -%}
          <div class="san-cart__empty">
            <div class="san-cart__empty-art" aria-hidden="true">
              <svg viewBox="0 0 140 160" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg">
                <ellipse cx="70" cy="98" rx="42" ry="6" />
                <path d="M28 98 Q30 138 70 144 Q110 138 112 98" />
                <path d="M40 138 Q70 142 100 138" opacity="0.4" />
                <path d="M70 98 C 68 80, 74 60, 68 40 C 64 28, 70 18, 68 8" />
                <path d="M70 84 Q 84 80 92 70" />
                <path d="M70 84 Q 82 84 92 70" />
                <path d="M68 64 Q 54 60 46 50" />
                <path d="M68 64 Q 56 64 46 50" />
                <path d="M70 44 Q 84 40 90 30" />
                <path d="M70 44 Q 82 44 90 30" />
                <circle cx="68" cy="8" r="2.4" fill="currentColor" stroke="none" />
                <circle cx="22" cy="118" r="1.2" fill="currentColor" stroke="none" opacity="0.5" />
                <circle cx="120" cy="124" r="1.2" fill="currentColor" stroke="none" opacity="0.5" />
                <circle cx="14" cy="134" r="0.9" fill="currentColor" stroke="none" opacity="0.35" />
              </svg>
            </div>
            <p class="san-cart__eyebrow">{{ 'san.cart.eyebrow' | t }}</p>
            <h2 class="san-cart__empty-title">{{ 'sections.cart.empty' | t }}</h2>
            <p class="san-cart__empty-sub">{{ 'san.cart.empty_sub' | t }}</p>
            <a href="{{ routes.all_products_collection_url }}" class="san-cart__empty-cta">
              {{- 'general.continue_shopping' | t -}}
            </a>

            {%- if shop.customer_accounts_enabled and customer == null -%}
              <p class="san-cart__empty-login">
                {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
              </p>
            {%- endif -%}
          </div>
        {%- else -%}
          <ul class="san-cart__items" role="list">
            {%- for item in cart.items -%}
              <li class="san-cart__item-row">
                <article
                  class="san-cart__item"
                  id="CartItem-{{ forloop.index }}"
                  data-line="{{ forloop.index }}"
                  data-quantity="{{ item.quantity }}"
                >
                  <a href="{{ item.url }}" class="san-cart__item-media{% unless item.image %} san-cart__item-media--placeholder{% endunless %}" tabindex="-1" aria-hidden="true">
                    {%- if item.image -%}
                      <img
                        src="{{ item.image | image_url: width: 360 }}"
                        alt="{{ item.image.alt | escape }}"
                        loading="lazy"
                        width="180"
                        height="225"
                      >
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 21 C 11 15, 13 9, 12 3" />
                        <path d="M12 15 Q 17 13 19 8 Q 13 9 12 15" />
                        <path d="M12 11 Q 7 9 5 4 Q 11 5 12 11" />
                      </svg>
                    {%- endif -%}
                  </a>

                  <div class="san-cart__item-body">
                    {%- if settings.show_vendor and item.product.vendor != blank -%}
                      <p class="san-cart__item-vendor">{{ item.product.vendor | escape }}</p>
                    {%- endif -%}

                    <a href="{{ item.url }}" class="san-cart__item-name">{{ item.product.title | escape }}</a>

                    {%- if item.product.has_only_default_variant == false or item.properties.size != 0 or item.selling_plan_allocation != null -%}
                      <dl class="san-cart__item-options">
                        {%- if item.product.has_only_default_variant == false -%}
                          {%- for option in item.options_with_values -%}
                            <div class="san-cart__item-option">
                              <dt>{{ option.name }}:</dt>
                              <dd>{{ option.value }}</dd>
                            </div>
                          {%- endfor -%}
                        {%- endif -%}
                        {%- for property in item.properties -%}
                          {%- assign property_first_char = property.first | slice: 0 -%}
                          {%- if property.last != blank and property_first_char != '_' -%}
                            <div class="san-cart__item-option">
                              <dt>{{ property.first }}:</dt>
                              <dd>{{ property.last }}</dd>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if item.selling_plan_allocation != null -%}
                          <div class="san-cart__item-option">
                            <dd>{{ item.selling_plan_allocation.selling_plan.name }}</dd>
                          </div>
                        {%- endif -%}
                      </dl>
                    {%- endif -%}

                    {%- if item.line_level_discount_allocations.size > 0 -%}
                      <ul class="san-cart__item-discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                        {%- for discount in item.line_level_discount_allocations -%}
                          <li>{{ discount.discount_application.title | escape }} · −{{ discount.amount | money }}</li>
                        {%- endfor -%}
                      </ul>
                    {%- endif -%}

                    <div class="san-cart__item-foot">
                      <div class="san-cart__stepper" role="group" aria-label="{{ 'products.product.quantity.label' | t }}">
                        <button
                          type="button"
                          data-action="qty-minus"
                          aria-label="{{ 'products.product.quantity.decrease' | t: product: item.product.title | escape }}"
                        >
                          <svg viewBox="0 0 14 2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M1 1 H13" /></svg>
                        </button>
                        <span class="san-cart__stepper-value" aria-live="polite">{{ item.quantity }}</span>
                        <button
                          type="button"
                          data-action="qty-plus"
                          aria-label="{{ 'products.product.quantity.increase' | t: product: item.product.title | escape }}"
                        >
                          <svg viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" aria-hidden="true"><path d="M7 1 V13 M1 7 H13" /></svg>
                        </button>
                      </div>

                      <a
                        href="{{ item.url_to_remove }}"
                        class="san-cart__item-remove"
                        data-action="remove"
                        aria-label="{{ 'sections.cart.remove_title' | t: title: item.title | escape }}"
                      >
                        {{- 'san.cart.remove' | t -}}
                      </a>

                      <div class="san-cart__item-price">
                        {%- if item.original_line_price != item.final_line_price -%}
                          <s class="san-cart__item-price-old">{{ item.original_line_price | money }}</s>
                        {%- endif -%}
                        <span class="san-cart__item-price-final">{{ item.final_line_price | money }}</span>
                        {%- if item.variant.available and item.unit_price_measurement -%}
                          <span class="san-cart__item-unit-price">
                            {{ item.unit_price | money }}
                            /
                            {%- if item.unit_price_measurement.reference_value != 1 -%}
                              {{- item.unit_price_measurement.reference_value -}}
                            {%- endif -%}
                            {{ item.unit_price_measurement.reference_unit }}
                          </span>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>

                  <div class="san-cart__item-veil" aria-hidden="true"></div>
                </article>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </form>

    <aside class="san-cart__aside">
      <div class="san-cart__summary">
        <div class="san-cart__letterhead">
          <span>{{ 'san.cart.summary_eyebrow' | t }}</span>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 21 C 11 15, 13 9, 12 3" />
            <path d="M12 15 Q 17 13 19 8 Q 13 9 12 15" />
            <path d="M12 11 Q 7 9 5 4 Q 11 5 12 11" />
          </svg>
        </div>

        <div class="san-cart__totals" data-swap="totals">
          <p class="san-cart__items-count">{{ 'san.cart.items_count' | t: count: cart.item_count }}</p>

          {%- if cart.cart_level_discount_applications.size > 0 -%}
            <ul class="san-cart__cart-discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
              {%- for discount in cart.cart_level_discount_applications -%}
                <li>{{ discount.title | escape }} · −{{ discount.total_allocated_amount | money }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="san-cart__subtotal">
            <span class="san-cart__subtotal-label">{{ 'sections.cart.estimated_total' | t }}</span>
            <strong class="san-cart__subtotal-value">{{ cart.total_price | money_with_currency }}</strong>
          </div>

          <p class="san-cart__tax-note">
            {%- if cart.duties_included and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{ 'sections.cart.duties_and_taxes_included_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{ 'sections.cart.taxes_included_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
              {%- endif -%}
            {%- elsif cart.duties_included and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{ 'sections.cart.duties_included_taxes_at_checkout_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
              {%- endif -%}
            {%- elsif cart.duties_included == false and cart.taxes_included == false -%}
              {%- if shop.shipping_policy.body == blank -%}
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_without_policy' | t }}
              {%- else -%}
                {{ 'sections.cart.taxes_at_checkout_shipping_at_checkout_with_policy_html' | t: link: shop.shipping_policy.url }}
              {%- endif -%}
            {%- endif -%}
          </p>
        </div>

        {%- if settings.show_cart_note -%}
          <details class="san-cart__note"{% if cart.note != blank %} open{% endif %}>
            <summary>{{ 'san.cart.note_toggle' | t }}</summary>
            <textarea
              name="note"
              form="cart"
              id="Cart-note"
              data-cart-note
              placeholder="{{ 'san.cart.note_placeholder' | t }}"
              aria-label="{{ 'sections.cart.note' | t }}"
            >{{ cart.note }}</textarea>
          </details>
        {%- endif -%}

        <button
          type="submit"
          id="checkout"
          form="cart"
          name="checkout"
          class="san-cart__checkout"
          data-checkout-button
          {% if cart == empty %}disabled{% endif %}
        >
          {{ 'sections.cart.checkout' | t }}
        </button>

        {%- if additional_checkout_buttons -%}
          <div class="san-cart__dynamic-buttons additional-checkout-buttons additional-checkout-buttons--vertical">
            {{ content_for_additional_checkout_buttons }}
          </div>
        {%- endif -%}

        <p class="san-cart__reassurance">{{ 'san.cart.reassurance' | t }}</p>
      </div>
    </aside>
  </div>

  <p class="visually-hidden" data-live-region aria-live="polite" role="status"></p>
</san-cart-page>

{% schema %}
{
  "name": "t:sections.main-cart-items.name",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 96
    }
  ]
}
{% endschema %}
