  {%- assign story = story_blocks.first -%}
  <div class="sa-story" id="sa-story">
    <div class="sa-story__inner">
      <div class="sa-story__media" data-reveal="left">
        <div class="sa-story__frame" aria-hidden="true"></div>

        <div class="sa-story__img-wrap sa-story__img-wrap--main">
          {%- if story.settings.image != blank -%}
            {{ story.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 50vw, 100vw', alt: 'Sana al Natural'
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- comment -%} Secondary stacked photo {%- endcomment -%}
        <div class="sa-story__img-float">
          {%- if story.settings.image_2 != blank -%}
            {{ story.settings.image_2 | image_url: width: 600 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 18vw, 40vw', alt: 'Sana al Natural'
            }}
          {%- else -%}
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          {%- endif -%}
        </div>

        {%- comment -%} Floating leaf {%- endcomment -%}
        <svg
          class="sa-story__leaf"
          viewBox="0 0 80 80"
          fill="none"
          aria-hidden="true">
          <path
            d="M40 10 C20 25 10 45 15 65 C20 75 35 78 45 70 C55 62 65 40 40 10Z"
            fill="#55823d"
            opacity="0.12" />
          <path
            d="M40 10 C40 10 38 35 30 55"
            stroke="#55823d"
            stroke-width="0.8"
            fill="none"
            opacity="0.15" />
        </svg>
      </div>

      <div class="sa-story__content" data-reveal>
        {%- comment -%} Growing botanical vine — natural-identity motion {%- endcomment -%}
        <svg
          class="sa-story__vine"
          viewBox="0 0 64 260"
          fill="none"
          aria-hidden="true">
