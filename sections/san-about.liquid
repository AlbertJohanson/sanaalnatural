                    {%- when 4 -%}<svg viewBox="0 0 48 48" fill="none"><rect class="sa-partners__ico-draw" pathLength="1" x="5" y="15" width="22" height="17" stroke="currentColor" stroke-width="1.5"/><path d="M27 20 H36 L42 26 V32 H27Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><circle cx="14" cy="36" r="3.4" stroke="currentColor" stroke-width="1.4"/><circle cx="34" cy="36" r="3.4" stroke="currentColor" stroke-width="1.4"/></svg>
                  {%- endcase -%}
                </div>
                <span class="sa-partners__panel-num" aria-hidden="true">0{{ i }}</span>
                <h3 class="sa-partners__panel-title">{{ p_title | t }}</h3>
                <p class="sa-partners__panel-text">{{ p_text | t }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- comment -%} Wholesale CTA — real WhatsApp + email from the PDF {%- endcomment -%}
