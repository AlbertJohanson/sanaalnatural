            class="sa-story__vine-stem"
            pathLength="1"
            d="M32 252 C32 214 27 192 32 160 C37 128 28 104 33 72 C35 50 33 28 32 12"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round" />
          <path
            class="sa-story__vine-leaf sa-story__vine-leaf--1"
            pathLength="1"
            d="M31 168 C15 162 8 147 11 130 C26 136 34 151 31 168Z"
            stroke="currentColor"
            stroke-width="1.2" />
          <path
            class="sa-story__vine-leaf sa-story__vine-leaf--2"
            pathLength="1"
            d="M33 112 C49 106 56 91 53 74 C38 80 30 95 33 112Z"
            stroke="currentColor"
            stroke-width="1.2" />
          <circle
            class="sa-story__vine-bud"
            cx="32"
            cy="12"
            r="4.5"
            fill="currentColor" />
        </svg>

        <p class="sa-story__eyebrow">{{ 'san.about.story.eyebrow' | t }}</p>

