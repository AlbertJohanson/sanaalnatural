                    {%- when 2 -%}<svg viewBox="0 0 48 48" fill="none"><path class="sa-partners__ico-draw" pathLength="1" d="M10 18 H38 L35 40 H13Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M18 18 L23 9 M30 18 L25 9" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/><path d="M19 24 V34 M24 24 V34 M29 24 V34" stroke="currentColor" stroke-width="1.1"/></svg>
