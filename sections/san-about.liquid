        <p class="sa-partners__cta-text">{{ 'san.about.partners.cta_text' | t }}</p>
        <div class="sa-partners__cta-actions">
          {%- if wa_digits != blank -%}
            <a class="sa-partners__btn sa-partners__btn--primary"
               href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.15-1.7-.84-2-.94-.26-.1-.45-.15-.64.15-.19.29-.74.93-.9 1.12-.17.19-.33.21-.62.07-.3-.15-1.25-.46-2.38-1.47-.88-.78-1.47-1.75-1.64-2.04-.17-.29-.02-.45.13-.6.13-.13.3-.34.44-.5.15-.17.2-.29.3-.48.1-.19.05-.36-.02-.5-.08-.15-.64-1.55-.88-2.12-.23-.55-.47-.48-.64-.49l-.55-.01c-.19 0-.5.07-.76.36-.26.29-1 .98-1 2.38s1.02 2.76 1.17 2.95c.15.19 2.01 3.06 4.87 4.29.68.29 1.21.47 1.62.6.68.22 1.3.19 1.79.11.55-.08 1.7-.69 1.94-1.36.24-.67.24-1.24.17-1.36-.07-.12-.26-.19-.55-.34z"/><path d="M12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.18-3 .94.95-2.92-.2-.31A8.2 8.2 0 1 1 12 20.2z"/></svg>
              {{ 'san.about.partners.cta_whatsapp' | t }}
            </a>
          {%- endif -%}
          {%- if section.settings.partners_email != blank -%}
            <a class="sa-partners__btn sa-partners__btn--ghost"
               href="mailto:{{ section.settings.partners_email }}">
              {{ 'san.about.partners.cta_email' | t }}
