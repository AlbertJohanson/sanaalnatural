          {%- endif -%}
        </div>
      </div>
    </div>
  </div>

</section>


{%- comment -%} ═══════ JAVASCRIPT ═══════ {%- endcomment -%}
<script>
  (function() {
    const section = document.querySelector('#san-about-{{ section.id }}');
    if (!section) return;

    /* ── Scroll reveal (IntersectionObserver) ── */
    const revealEls = section.querySelectorAll('[data-reveal], [data-reveal-stagger]');

    if (revealEls.length && 'IntersectionObserver' in window) {
      const revealObs = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            revealObs.unobserve(entry.target);
          }
        });
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });

      revealEls.forEach(function(el) { revealObs.observe(el); });
    } else {
      /* Fallback: show everything */
      revealEls.forEach(function(el) { el.classList.add('is-visible'); });
    }

    /* ── Distributors — tabs + 3D tilt ── */
    var pTabs = section.querySelector('[data-partner-tabs]');
    if (pTabs) {
      var tabs = Array.prototype.slice.call(pTabs.querySelectorAll('[data-partner-tab]'));
      var panels = Array.prototype.slice.call(pTabs.querySelectorAll('[data-partner-panel]'));
      var stage = pTabs.querySelector('[data-partner-stage]');
      var activeIdx = 0;
      var pAuto = null;

      function activate(idx) {
        if (idx < 0) idx = tabs.length - 1;
        if (idx >= tabs.length) idx = 0;
        activeIdx = idx;
        tabs.forEach(function(t, i) {
          var on = i === idx;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.setAttribute('tabindex', on ? '0' : '-1');
        });
        panels.forEach(function(p, i) {
          var on = i === idx;
          p.classList.toggle('is-active', on);
          if (on) { p.removeAttribute('hidden'); } else { p.setAttribute('hidden', ''); }
        });
      }

      tabs.forEach(function(t, i) {
        t.addEventListener('click', function() { activate(i); });
        t.addEventListener('keydown', function(e) {
          if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
            e.preventDefault(); activate(activeIdx + 1); tabs[activeIdx].focus();
          } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
            e.preventDefault(); activate(activeIdx - 1); tabs[activeIdx].focus();
          }
        });
      });

      /* Auto-rotate until the user interacts */
      function stopAuto() { if (pAuto) { clearInterval(pAuto); pAuto = null; } }
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        pAuto = setInterval(function() { activate(activeIdx + 1); }, 5000);
        pTabs.addEventListener('mouseenter', stopAuto);
        pTabs.addEventListener('focusin', stopAuto);
        pTabs.addEventListener('click', stopAuto);
      }

      /* 3D tilt of the active panel following the cursor */
      if (stage && window.matchMedia('(hover: hover)').matches &&
          !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var rafT = false;
        stage.addEventListener('pointermove', function(e) {
          if (rafT) return;
          rafT = true;
          requestAnimationFrame(function() {
            var r = stage.getBoundingClientRect();
            var px = (e.clientX - r.left) / r.width - 0.5;
            var py = (e.clientY - r.top) / r.height - 0.5;
            stage.style.setProperty('--ry', (px * 12).toFixed(2) + 'deg');
            stage.style.setProperty('--rx', (-py * 12).toFixed(2) + 'deg');
            rafT = false;
          });
        });
        stage.addEventListener('pointerleave', function() {
          stage.style.setProperty('--ry', '0deg');
          stage.style.setProperty('--rx', '0deg');
        });
      }
    }

    /* ── Parallax hero (subtle) ── */
    var hero = section.querySelector('.sa-hero');
    if (hero) {
      var heroMedia = hero.querySelector('.sa-hero__col--media');
      var heroMark = hero.querySelector('.sa-hero__watermark');
      var ticking = false;

      window.addEventListener('scroll', function() {
        if (!ticking) {
          requestAnimationFrame(function() {
            var rect = hero.getBoundingClientRect();
            if (rect.bottom > 0 && rect.top < window.innerHeight) {
              var scrolled = -rect.top;
              if (heroMedia) heroMedia.style.transform = 'translateY(' + (scrolled * 0.12) + 'px)';
              if (heroMark) heroMark.style.transform = 'translateY(' + (scrolled * 0.05) + 'px)';
            }
            ticking = false;
          });
          ticking = true;
        }
      }, { passive: true });
    }

    /* ── Values bento — cursor-following spotlight ── */
    var vtiles = section.querySelectorAll('[data-vtile]');
    vtiles.forEach(function(tile) {
      tile.addEventListener('pointermove', function(e) {
        var r = tile.getBoundingClientRect();
        tile.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 100) + '%');
        tile.style.setProperty('--my', ((e.clientY - r.top) / r.height * 100) + '%');
      });
    });
  })();
</script>


