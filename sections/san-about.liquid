    <div class="sa-hero__grain" aria-hidden="true"></div>
    <div class="sa-hero__watermark" aria-hidden="true">
      <span>Sana</span>
      <span>al</span>
      <span>Natural</span>
    </div>

    {%- comment -%} Ambient drifting leaves {%- endcomment -%}
    <div class="sa-hero__ambient" aria-hidden="true">
      <span class="sa-hero__leaf sa-hero__leaf--1">
        <svg viewBox="0 0 60 60" fill="none"><path d="M30 6 C14 20 6 36 12 50 C16 58 30 60 38 52 C46 44 52 28 30 6Z" fill="currentColor" /><path
            d="M30 6 C30 6 28 32 18 46"
            stroke="#31591d"
            stroke-width="0.8"
            opacity="0.4" /></svg>
      </span>
      <span class="sa-hero__leaf sa-hero__leaf--2">
        <svg viewBox="0 0 60 60" fill="none"><path d="M30 6 C14 20 6 36 12 50 C16 58 30 60 38 52 C46 44 52 28 30 6Z" fill="currentColor" /></svg>
      </span>
      <span class="sa-hero__leaf sa-hero__leaf--3">
        <svg viewBox="0 0 60 60" fill="none"><path d="M30 6 C14 20 6 36 12 50 C16 58 30 60 38 52 C46 44 52 28 30 6Z" fill="currentColor" /></svg>
      </span>
    </div>

    <div class="sa-hero__inner">
      {%- comment -%} Top eyebrow row with drawing rule {%- endcomment -%}
      <div class="sa-hero__top">
        <p class="sa-hero__eyebrow">{{ 'san.about.hero.eyebrow' | t }}</p>
      </div>

      <div class="sa-hero__grid">
        {%- comment -%} Headline column {%- endcomment -%}
        <div class="sa-hero__col sa-hero__col--text">
          {%- assign hero_heading = 'san.about.hero.heading' | t -%}
          <div class="sa-hero__heading-wrap">
            <h1 class="sa-hero__heading">
              {%- assign h_parts = hero_heading | split: '|' -%}
              {%- for part in h_parts -%}
                {%- if forloop.index == 2 -%}
                  <em>{{ part }}</em>
                {%- else -%}
                  {{ part }}{%- endif -%}
              {%- endfor -%}
            </h1>
          </div>

          <p class="sa-hero__subtitle">{{ 'san.about.hero.subtitle' | t }}</p>
        </div>
      </div>

      {%- comment -%} Scroll invitation (replaces CTA buttons) {%- endcomment -%}
      <a class="sa-hero__scroll" href="#sa-story">
        <span class="sa-hero__scroll-label">{{ 'san.about.hero.scroll' | t }}</span>
        <span class="sa-hero__scroll-track">
          <span class="sa-hero__scroll-dot"></span>
        </span>
      </a>
    </div>
</div>


