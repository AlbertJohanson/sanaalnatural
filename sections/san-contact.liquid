{{ 'san-contact.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  SANA AL NATURAL — Contacto (v2)
  Deep-green canvas. Full-width header (eyebrow / heading / intro from
  san.contact.* locale keys), then a two-column body: sticky rail with
  channels + social + optional photo on the green, and the white
  "letter" form card with its letterhead signature.

  All copy is theme i18n (san.contact.*); the subject dropdown is built
  from san.contact.subjects.{general,order,wholesale,press,other} via
  key-append — no admin blocks. Field names stay Spanish so the
  merchant email reads naturally: contact[Nombre], contact[email],
  contact[Teléfono], contact[Motivo], contact[Mensaje].
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.65 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.65 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign wa_digits = section.settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')'
  assign subject_keys = 'general,order,wholesale,press,other' | split: ','
  assign first_placeholder_key = 'san.contact.subjects.general.placeholder'
-%}

<div class="san-contact section-{{ section.id }}-padding" data-san-contact>
  <div class="san-contact__inner">

    <header class="san-contact__head">
      <p class="san-contact__eyebrow">{{ 'san.contact.eyebrow' | t }}</p>

      <h2 class="san-contact__heading">
        {%- assign heading = 'san.contact.heading' | t -%}
        {%- assign heading_parts = heading | split: '|' -%}
        {%- for part in heading_parts -%}
          {%- if forloop.index == 2 -%}
            <em class="san-contact__heading-accent">{{ part }}</em>
          {%- else -%}
            {{ part }}
          {%- endif -%}
        {%- endfor -%}
      </h2>

      <p class="san-contact__intro">{{ 'san.contact.intro' | t }}</p>
    </header>

    <div class="san-contact__body">

      {%- comment -%} ────── Rail: channels on the green ────── {%- endcomment -%}
      <aside class="san-contact__rail">

        {%- if section.settings.email != blank or section.settings.whatsapp_number != blank or section.settings.address_line_1 != blank -%}
          <ul class="san-contact__channels" role="list">

            {%- if section.settings.email != blank -%}
              <li class="san-contact__channel">
                <span class="san-contact__channel-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="5" width="18" height="14" rx="1.5"/>
                    <path d="M3 7l9 6 9-6"/>
                  </svg>
                </span>
                <div class="san-contact__channel-body">
                  <span class="san-contact__channel-label">{{ 'san.contact.channel_email' | t }}</span>
                  <a href="mailto:{{ section.settings.email }}" class="san-contact__channel-value">{{ section.settings.email }}</a>
                </div>
              </li>
            {%- endif -%}

            {%- if section.settings.whatsapp_number != blank -%}
              <li class="san-contact__channel">
                <span class="san-contact__channel-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
                  </svg>
                </span>
                <div class="san-contact__channel-body">
                  <span class="san-contact__channel-label">{{ 'san.contact.channel_whatsapp' | t }}</span>
                  <a href="https://wa.me/{{ wa_digits }}" target="_blank" rel="noopener" class="san-contact__channel-value">
                    {{- section.settings.whatsapp_display | default: section.settings.whatsapp_number -}}
                  </a>
                </div>
              </li>
            {%- endif -%}

            {%- if section.settings.address_line_1 != blank -%}
              <li class="san-contact__channel">
                <span class="san-contact__channel-icon" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                  </svg>
                </span>
                <div class="san-contact__channel-body">
                  <span class="san-contact__channel-label">{{ 'san.contact.channel_location' | t }}</span>
                  <span class="san-contact__channel-value">
                    {{ section.settings.address_line_1 }}
                    {%- if section.settings.address_line_2 != blank -%}
                      <br>{{ section.settings.address_line_2 }}
                    {%- endif -%}
                  </span>
                </div>
              </li>
            {%- endif -%}

          </ul>
        {%- endif -%}

        {%- if section.settings.instagram_url != blank or section.settings.facebook_url != blank or section.settings.tiktok_url != blank -%}
          <div class="san-contact__social">
            <span class="san-contact__social-label">{{ 'san.contact.follow' | t }}</span>
            <ul class="san-contact__social-list" role="list">
              {%- if section.settings.instagram_url != blank -%}
                <li>
                  <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram" class="san-contact__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3" y="3" width="18" height="18" rx="5"/>
                      <circle cx="12" cy="12" r="4"/>
                      <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.facebook_url != blank -%}
                <li>
                  <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook" class="san-contact__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
              {%- if section.settings.tiktok_url != blank -%}
                <li>
                  <a href="{{ section.settings.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok" class="san-contact__social-link">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M15 3v10.5a3.5 3.5 0 11-3.5-3.5"/>
                      <path d="M15 3c.3 2.5 2 4.5 4.5 4.8"/>
                    </svg>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.brand_image != blank -%}
          <div class="san-contact__image-wrap">
            {{ section.settings.brand_image | image_url: width: 1200 | image_tag:
              loading: 'lazy',
              sizes: '(min-width: 990px) 32rem, 100vw',
              widths: '400, 600, 800, 1000, 1200',
              class: 'san-contact__image'
            }}
          </div>
        {%- endif -%}

      </aside>

      {%- comment -%} ────── The letter: white form card ────── {%- endcomment -%}
      <div class="san-contact__card">

        <div class="san-contact__letterhead">
          <span class="san-contact__letterhead-text">{{ 'san.contact.letterhead' | t }}</span>
          <svg class="san-contact__letterhead-leaf" viewBox="0 0 15 20" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7.5 1.5 C 11.5 5.5, 13 10, 7.5 15.5 C 2 10, 3.5 5.5, 7.5 1.5 Z"/>
            <path d="M7.5 6 V 18.5"/>
          </svg>
        </div>

        {%- form 'contact', id: 'SanContactForm', class: 'san-contact__form' -%}

          {%- if form.posted_successfully? -%}
            <div class="san-contact__success" role="status" tabindex="-1" autofocus>
              <span class="san-contact__success-icon" aria-hidden="true">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="20 6 9 17 4 12"/>
                </svg>
              </span>
              <h3 class="san-contact__success-title">{{ 'san.contact.success_title' | t }}</h3>
              <p class="san-contact__success-text">{{ 'san.contact.success_text' | t }}</p>
            </div>
          {%- elsif form.errors -%}
            <div class="san-contact__error" role="alert" tabindex="-1" autofocus>
              <span class="san-contact__error-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="12" y1="8" x2="12" y2="12"/>
                  <line x1="12" y1="16" x2="12.01" y2="16"/>
                </svg>
              </span>
              <p class="san-contact__error-text">
                {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
              </p>
            </div>
          {%- endif -%}

          <div class="san-contact__fields">

            <div class="san-contact__field">
              <label class="san-contact__label" for="SanContactForm-name">{{ 'san.contact.label_name' | t }}</label>
              <input
                class="san-contact__input"
                type="text"
                id="SanContactForm-name"
                name="contact[Nombre]"
                autocomplete="name"
                placeholder="{{ 'san.contact.placeholder_name' | t | escape }}"
                value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
              >
            </div>

            <div class="san-contact__field">
              <label class="san-contact__label" for="SanContactForm-email">
                {{ 'san.contact.label_email' | t }} <span class="san-contact__required" aria-hidden="true">*</span>
              </label>
              <input
                class="san-contact__input{% if form.errors contains 'email' %} san-contact__input--error{% endif %}"
                type="email"
                id="SanContactForm-email"
                name="contact[email]"
                autocomplete="email"
                spellcheck="false"
                autocapitalize="off"
                aria-required="true"
                placeholder="{{ 'san.contact.placeholder_email' | t | escape }}"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}
              >
            </div>

            <div class="san-contact__field">
              <label class="san-contact__label" for="SanContactForm-phone">{{ 'san.contact.label_phone' | t }}</label>
              <input
                class="san-contact__input"
                type="tel"
                id="SanContactForm-phone"
                name="contact[Teléfono]"
                autocomplete="tel"
                placeholder="{{ 'san.contact.placeholder_phone' | t | escape }}"
                value="{% if form.phone %}{{ form.phone }}{% endif %}"
              >
            </div>

            <div class="san-contact__field">
              <label class="san-contact__label" for="SanContactForm-subject">{{ 'san.contact.label_subject' | t }}</label>
              <div class="san-contact__select-wrap">
                <select
                  class="san-contact__select"
                  id="SanContactForm-subject"
                  name="contact[Motivo]"
                  data-san-contact-subject
                >
                  {%- for key in subject_keys -%}
                    {%- assign label_key = 'san.contact.subjects.' | append: key | append: '.label' -%}
                    {%- assign placeholder_key = 'san.contact.subjects.' | append: key | append: '.placeholder' -%}
                    <option
                      value="{{ label_key | t | escape }}"
                      data-placeholder="{{ placeholder_key | t | escape }}"
                    >{{ label_key | t }}</option>
                  {%- endfor -%}
                </select>
                <span class="san-contact__select-caret" aria-hidden="true">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </span>
              </div>
            </div>

            <div class="san-contact__field san-contact__field--full">
              <label class="san-contact__label" for="SanContactForm-body">{{ 'san.contact.label_message' | t }}</label>
              <textarea
                class="san-contact__textarea"
                id="SanContactForm-body"
                name="contact[Mensaje]"
                rows="5"
                placeholder="{{ first_placeholder_key | t | escape }}"
                data-san-contact-body
              >{{ form.body }}</textarea>
            </div>

          </div>

          <div class="san-contact__submit-wrap">
            <button type="submit" class="san-contact__submit">
              <span>{{ 'san.contact.submit' | t }}</span>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
              </svg>
            </button>
          </div>

        {%- endform -%}
      </div>

    </div>
  </div>
</div>

<script>
  (function() {
    var scope = document.querySelector('[data-san-contact]');
    if (!scope) return;
    var subject = scope.querySelector('[data-san-contact-subject]');
    var body = scope.querySelector('[data-san-contact-body]');
    if (!subject || !body) return;

    function update() {
      var opt = subject.options[subject.selectedIndex];
      var ph = opt && opt.getAttribute('data-placeholder');
      if (ph) body.setAttribute('placeholder', ph);
    }

    subject.addEventListener('change', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Contacto (Sana)",
  "tag": "section",
  "class": "section section--san-contact",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    { "type": "header", "content": "Imagen" },
    {
      "type": "image_picker",
      "id": "brand_image",
      "label": "Foto editorial (columna lateral)"
    },
    { "type": "header", "content": "Canales de contacto" },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "info@sanaalnatural.com"
    },
    {
      "type": "text",
      "id": "whatsapp_number",
      "label": "Número de WhatsApp",
      "info": "Con código de país, solo dígitos (ej. 18185321110)",
      "default": "18185321110"
    },
    {
      "type": "text",
      "id": "whatsapp_display",
      "label": "WhatsApp (texto visible)",
      "default": "+1 818 532 1110"
    },
    {
      "type": "text",
      "id": "address_line_1",
      "label": "Dirección (línea 1)",
      "default": "20117 Vanowen St, Winnetka, CA 91306"
    },
    {
      "type": "text",
      "id": "address_line_2",
      "label": "Dirección (línea 2)",
      "default": "Estados Unidos"
    },
    { "type": "header", "content": "Redes sociales" },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    { "type": "header", "content": "Espaciado" },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Relleno superior",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Relleno inferior",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Contacto (Sana)"
    }
  ]
}
{% endschema %}
